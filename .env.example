# Copy to .env (`make env` does it and fills in random passwords).
# .env is gitignored. Never put real values in this file.

POSTGRES_USER=alerts
POSTGRES_PASSWORD=
POSTGRES_DB=alerts
GRAFANA_ADMIN_PASSWORD=
LOG_LEVEL=info

# Signs unsubscribe links (shared by api and delivery). `make env` fills it.
UNSUBSCRIBE_SECRET=

# Email. Leave empty in development: everything goes to Mailpit.
# Production (Gmail): SMTP_HOST=smtp.gmail.com SMTP_PORT=587, SMTP_USER=you@yourdomain,
# SMTP_PASSWORD=<a Google app password, never the account password>.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# PropTx tokens for `make live`. `make tokens` copies them from the macOS
# Keychain (market-report-proptx, idx-proptx) without printing them.
PROPTX_VOW_TOKEN=
PROPTX_IDX_TOKEN=

